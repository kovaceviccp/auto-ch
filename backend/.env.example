# Database (Neon)
DATABASE_URL=postgresql+asyncpg://neondb_owner:password@ep-xxx.neon.tech/neondb
DATABASE_URL_SYNC=postgresql://neondb_owner:password@ep-xxx.neon.tech/neondb?sslmode=require
DB_SSL=true

# Auth
SECRET_KEY=changeme-in-production-use-strong-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis (Upstash ili lokalni)
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGINS=["https://your-app.vercel.app"]

# Supabase Storage
USE_SUPABASE=true
SUPABASE_URL=https://ahdpiteckttlslontldd.supabase.co
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_BUCKET=autoch-images
